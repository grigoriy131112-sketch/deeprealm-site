# Server
PORT=3000

# AI provider (server-side only; never exposed to the browser).
# Any OpenAI-compatible endpoint works. Free options:

# --- Google AI Studio (Gemini) — free tier ---
# Get a key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-latest
# Optional: retry with these models if the main one is busy/unavailable
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash

# Как часто перечитывать блог Deeprealm на новые расы/классы игроков (минуты; 0 — выключить)
BLOG_SYNC_MINUTES=60

# --- Groq — free tier ---
# Get a key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- OpenRouter — free models (:free) ---
# Get a key: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- OpenAI (paid) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

LLM_API_KEY=
