# Server
PORT=3000

# AI provider (optional: the built-in engine answers without any key).
# A key only improves the wording of free-form answers.
# Any OpenAI-compatible endpoint works. Free options:

# --- Google AI Studio (Gemini) — free tier ---
# Get a key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-lite-latest
# Optional: retry with these models if the main one is busy/unavailable
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview

# Как часто перечитывать блог Deeprealm на новые расы/классы игроков (минуты; 0 — выключить)
BLOG_SYNC_MINUTES=60

# Статьи (расы, классы, лор) лежат в data/articles.json внутри контейнера.
# Одобренные расы и классы уходят в репозиторий через GitHub API и читаются
# обратно при старте, поэтому перезапуск хостинга их не теряет. Постоянный диск
# не нужен. Для публикации нужны GITHUB_REPO и GITHUB_TOKEN с правом записи:
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=
# SITE_BRANCH=main
# SITE_AUTOPUBLISH=off   # выключить публикацию из репозитория (по умолчанию включена)
# ARTICLES_PATH=/data/articles.json   # необязательно: свой путь к файлу статей

# --- Groq — free tier ---
# Get a key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- OpenRouter — free models (:free) ---
# Get a key: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- OpenAI (paid) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Keyless public endpoint (optional, no key) ---
# Tried for the Guide chat when LLM_API_KEY is empty. It is often unavailable,
# so it is only a wording upgrade; the built-in engine answers either way.
# FREE_LLM_BASE_URL=https://text.pollinations.ai/openai
# FREE_LLM_MODEL=openai-fast

# --- Live speech (optional, no key) -------------------------------------------
# The built-in engine always answers, but its wording is assembled from the
# knowledge base. This layer asks a free, keyless model to rewrite that answer in
# a natural voice. It is optional: a dead endpoint only means the engine's own
# wording is used. Point LIVE_LLM_* at any OpenAI-compatible endpoint to prefer
# your own provider.
# LIVE_LLM_BASE_URL=https://text.pollinations.ai/openai
# LIVE_LLM_MODEL=openai-fast

# --- Owner notifications through a Telegram bot -------------------------------
# The site tells the owner about every arrival and forwards approved sheets. Get
# the token from @BotFather and the chat id from @userinfobot, then either set the
# variables below or fill data/telegram.json (which is what GitHub Pages reads,
# since it cannot see these variables). Leave both empty to keep the site silent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Extra recipients for the same notifications, comma-separated (optional).
# TELEGRAM_CHAT_IDS=123456789,987654321
# How often the same browser session may report a visit, in minutes (default 360).
# TELEGRAM_VISIT_GAP_MINUTES=360

# Оставьте пустым, чтобы сайт работал на встроенном движке без ключа.
LLM_API_KEY=
